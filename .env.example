# LLM provider: openai | groq | mock  (empty = auto: openai if key set, else groq, else mock)
LLM_PROVIDER=
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Web search: mock (default) or live (DuckDuckGo Instant Answer API, no key needed)
WEB_SEARCH_MODE=mock
